      "llmDescription": "DeepSeek — competitive open models; the reasoner variant is tuned for step-by-step problems.",
      "defaultValues": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": [
        "deepseek-chat",
        "deepseek-reasoner"
      ],
