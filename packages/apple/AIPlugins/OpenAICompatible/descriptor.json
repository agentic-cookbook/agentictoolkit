{
  "schemaVersion": 3,
  "identifier": "com.agentictoolkit.plugin.openai-compatible",
  "displayName": "OpenAI-compatible",
  "version": "1.0",
  "models": [],
  "defaultModel": null,
  "fields": [
    {
      "key": "baseURL",
      "label": "Base URL",
      "kind": "text",
      "placeholder": "https://api.example.com/v1"
    },
    {
      "key": "apiKey",
      "label": "API Key",
      "kind": "secret"
    }
  ],
  "templates": [
