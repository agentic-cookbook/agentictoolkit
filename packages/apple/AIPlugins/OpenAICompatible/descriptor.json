      "configType": "API Key",
      "providerDescription": "Cerebras — ultra-fast inference on Cerebras hardware.",
      "defaultValues": {
        "baseURL": "https://api.cerebras.ai/v1"
      },
      "models": [
        "llama3.1-70b",
        "llama3.1-8b"
      ],
      "defaultModel": "llama3.1-70b",
      "secretRequired": true
    },
    {
