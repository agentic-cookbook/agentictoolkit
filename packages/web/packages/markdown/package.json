{
  "name": "@agentic-toolkit/markdown",
  "version": "0.1.0",
  "description": "Reusable markdown viewer component for the agentic-web-toolkit. Fetches a markdown row by id, renders GitHub-flavoured markdown with shiki syntax highlighting, and provides a data-driven theme switcher.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/components/markdown-viewer.css"
  ],
  "comment:exports": "`development` \u2192 src for `next dev` (HMR, no build/restart); prod skips it \u2192 dist. Mirrors the @adh-shared/ui convention.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./src/components/markdown-viewer.css"
  },
  "scripts": {
    "build": "tsup && pnpm run build:types",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@agentic-toolkit/ui": "workspace:*",
    "@shikijs/rehype": "^1.0.0",
    "gray-matter": "^4.0.3",
    "rehype-autolink-headings": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "shiki": "^1.0.0",
    "unified": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
