{
  "name": "@agentic-toolkit/data",
  "version": "0.1.0",
  "description": "Unified headless data model: authed HTTP, tenant, resource-list cache, feature domains.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "comment:exports": "`development` → src for `next dev` (HMR); prod skips it → dist.",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "development": "./src/index.ts", "import": "./dist/index.js" },
    "./projects": { "types": "./dist/projects/index.d.ts", "development": "./src/projects/index.ts", "import": "./dist/projects/index.js" }
  },
  "scripts": {
    "build": "tsup && pnpm run build:types",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "@agentic-toolkit/auth": "workspace:*" },
  "peerDependencies": { "react": "^19.0.0" },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "jsdom": "^29.0.2",
    "next": "^15.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
