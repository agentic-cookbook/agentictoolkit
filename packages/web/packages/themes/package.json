{
  "name": "@agentic-toolkit/themes",
  "version": "0.1.4",
  "description": "Theme manifest, ThemeStyle component, and ColorModeProvider for agentic-web-toolkit.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "comment:files": "`src/styles` + `src/tailwind.css` ship ALONGSIDE dist: the `./styles/*.css` and `./tailwind.css` exports resolve to `./src/...` unconditionally (prod too), and `pnpm deploy`/`npm pack` only include listed paths. See @agentic-toolkit/adh comment:files for the full rationale.",
  "files": [
    "dist",
    "src/styles",
    "src/tailwind.css"
  ],
  "comment:exports": "`development` \u2192 src for `next dev` (HMR, no build/restart); prod (NODE_ENV=production) skips it \u2192 dist. Self-degrading if the bundler ignores it. See @agentic-toolkit/adh for the full rationale. NOTE: src/theme-data.ts is generated by `build:data` \u2014 it must exist for the dev (src) path; `sites run` builds it on bootstrap.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./colorMode": {
      "types": "./dist/colorMode.d.ts",
      "development": "./src/colorMode.tsx",
      "import": "./dist/colorMode.js"
    },
    "./appearance": {
      "types": "./dist/appearance.d.ts",
      "development": "./src/appearance.ts",
      "import": "./dist/appearance.js"
    },
    "./appearance-store": {
      "types": "./dist/appearance-store.d.ts",
      "development": "./src/appearance-store.tsx",
      "import": "./dist/appearance-store.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "development": "./src/manifest.ts",
      "import": "./dist/manifest.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "development": "./src/tokens.ts",
      "import": "./dist/tokens.js"
    },
    "./styles/*.css": "./src/styles/*.css",
    "./tailwind.css": "./src/tailwind.css"
  },
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:contrast": "node scripts/contrast-check.mjs",
    "check:drift": "node scripts/build-tokens.mjs && git diff --exit-code src/styles/adh*.css",
    "build:data": "node scripts/build-theme-data.mjs",
    "build": "pnpm run build:tokens && pnpm run build:data && tsup && pnpm run build:types && pnpm run build:css",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "build:css": "node ../../copy-css.mjs",
    "dev": "pnpm run build:tokens && pnpm run build:data && tsup --watch",
    "clean": "rm -rf dist .turbo src/theme-data.ts",
    "lint": "pnpm run build:data && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentic-toolkit/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "jsdom": "^29.0.2",
    "style-dictionary": "^5.4.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
