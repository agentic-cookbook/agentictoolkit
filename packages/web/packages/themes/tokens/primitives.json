{
  "palette": {
    "$type": "color",
    "neutral": {
      "1000": { "$value": "#08080a", "$description": "near-black; surface-container-lowest" },
      "975":  { "$value": "#0a0a0d", "$description": "surface-dim" },
      "950":  { "$value": "#0c0c0f", "$description": "base dark surface" },
      "925":  { "$value": "#101014", "$description": "surface-container-low" },
      "900":  { "$value": "#14141a", "$description": "surface-container" },
      "860":  { "$value": "#1c1c24", "$description": "surface-container-high" },
      "820":  { "$value": "#24242e", "$description": "surface-container-highest" },
      "800":  { "$value": "#1e1e28", "$description": "outline-variant" },
      "780":  { "$value": "#2a2a35", "$description": "outline" },
      "760":  { "$value": "#2a2a36", "$description": "outline (chat surfaces; legacy near-dup of 780)" },
      "700":  { "$value": "#3d3d50", "$description": "outline-strong" },
      "bright":{ "$value": "#2a2a33", "$description": "surface-bright" },
      "600":  { "$value": "#5a5a6a", "$description": "dim text" },
      "500":  { "$value": "#8a8a9a", "$description": "on-surface-variant / secondary text" },
      "100":  { "$value": "#e8e6e3", "$description": "on-surface / primary text" }
    },
    "gold": {
      "200": { "$value": "#e7d3a3", "$description": "on-primary-container (light gold)" },
      "300": { "$value": "#d9bb74", "$description": "primary bright / hover" },
      "500": { "$value": "#c4a35a", "$description": "primary (brand gold)" },
      "700": { "$value": "#4a3d1f", "$description": "primary-container (dark gold)" },
      "800": { "$value": "#6b5a30", "$description": "inverse-primary" }
    },
    "taupe": {
      "200": { "$value": "#e0d6c4", "$description": "on-secondary-container" },
      "500": { "$value": "#a89a82", "$description": "secondary (muted bronze)" },
      "900": { "$value": "#2e2a22", "$description": "secondary-container" }
    },
    "blue": {
      "200": { "$value": "#c5d2ff", "$description": "on-tertiary/info-container" },
      "500": { "$value": "#6b8afd", "$description": "tertiary / info" },
      "900": { "$value": "#232b45", "$description": "tertiary/info-container" }
    },
    "green": {
      "200": { "$value": "#bfe6c9", "$description": "on-success-container" },
      "500": { "$value": "#5cb270", "$description": "success" },
      "900": { "$value": "#1e3a26", "$description": "success-container" }
    },
    "amber": {
      "200": { "$value": "#f3d4ad", "$description": "on-warning-container" },
      "500": { "$value": "#e08a3c", "$description": "warning (dev-preview orange)" },
      "900": { "$value": "#3d2a14", "$description": "warning-container" }
    },
    "red": {
      "200": { "$value": "#f3c0c0", "$description": "on-error-container" },
      "500": { "$value": "#d45454", "$description": "error" },
      "900": { "$value": "#3d1f1f", "$description": "error-container" }
    },
    "white": { "$value": "#ffffff" },
    "black": { "$value": "#000000" }
  },
  "alpha": {
    "$type": "color",
    "gold-15": { "$value": "rgba(196, 163, 90, 0.15)", "$description": "primary @ 15% — selection / accent-dim" },
    "gold-12": { "$value": "rgba(196, 163, 90, 0.12)", "$description": "chat persona bg" },
    "gold-25": { "$value": "rgba(196, 163, 90, 0.25)", "$description": "chat persona border" },
    "surface-94": { "$value": "rgba(20, 20, 26, 0.94)", "$description": "chat surface" },
    "white-06": { "$value": "rgba(255, 255, 255, 0.06)", "$description": "chat user bg" }
  },
  "font-family": {
    "$type": "fontFamily",
    "iosevka": {
      "$value": "'Iosevka', 'Iosevka Fallback Menlo', 'Iosevka Fallback Courier', ui-monospace, monospace",
      "$description": "ONE stack for all three roles. Iosevka is a single face used for sans, serif AND mono, so the roles must share a fallback too — serif used to end in Georgia, a PROPORTIONAL face, which re-wrapped every display heading the moment the webfont swapped in. The two Iosevka Fallback families are metric-matched local faces (see scripts/subset-fonts.py); they lay out at Iosevka's own advance, so the swap moves nothing."
    },
    "manrope": { "$value": "'Manrope', system-ui, sans-serif" },
    "instrument-serif": { "$value": "'Instrument Serif', Georgia, serif" },
    "dm-mono": { "$value": "'DM Mono', ui-monospace, monospace" },
    "comic-neue-sans": { "$value": "'Comic Neue', system-ui, sans-serif" },
    "comic-neue-serif": { "$value": "'Comic Neue', ui-serif, Georgia, serif" },
    "comic-neue-mono": { "$value": "'Comic Neue', ui-monospace, monospace" },
    "courier-prime-sans": { "$value": "'Courier Prime', ui-monospace, monospace" },
    "courier-prime-serif": { "$value": "'Courier Prime', ui-serif, Georgia, serif" },
    "courier-prime-mono": { "$value": "'Courier Prime', ui-monospace, monospace" },
    "fira-code-sans": { "$value": "'Fira Code', ui-monospace, monospace" },
    "fira-code-serif": { "$value": "'Fira Code', ui-serif, Georgia, serif" },
    "fira-code-mono": { "$value": "'Fira Code', ui-monospace, monospace" },
    "jetbrains-mono-sans": { "$value": "'JetBrains Mono', ui-monospace, monospace" },
    "jetbrains-mono-serif": { "$value": "'JetBrains Mono', ui-serif, Georgia, serif" },
    "jetbrains-mono-mono": { "$value": "'JetBrains Mono', ui-monospace, monospace" }
  }
}
