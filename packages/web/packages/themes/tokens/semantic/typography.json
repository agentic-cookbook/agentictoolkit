    "_landing": {
      "$description": "LANDING roles — the fluid, viewport-scaled type a marketing page uses, as opposed to the fixed M3 roles above (which size UI chrome, where a heading must not grow with the window). Every family landing page hand-rolled its own clamp() and its own rem values, so the same tier rendered at 25.6px on 31 sites and 36px on the cookbook; these six roles are that scale written down ONCE. The numbers are the family's existing baseline (shared/adh SiteLanding + .adh-story__* in adh-concepts.css), so adopting them re-sizes only the pages that had drifted off it. Six tiers because six is what the pages actually distinguish: page title, secondary/closing title, section heading, hero lede, section body, mono eyebrow. Emitted by scripts/build-tokens.mjs as --type-landing-*-* vars plus .text-landing-* utility classes; consumers should REPLACE their Tailwind size classes with these rather than layering, since both land at (0,1,0) specificity and load order would decide the winner."
    },
    "landing-title":    { "font": { "$value": "{font.serif}", "$type": "fontFamily" }, "size": { "$value": "clamp(2.6rem, 6vw, 4.5rem)", "$type": "dimension" }, "line-height": { "$value": "1.04", "$type": "number" }, "weight": { "$value": "400", "$type": "fontWeight" }, "tracking": { "$value": "-0.02em", "$type": "dimension" } },
    "landing-subtitle": { "font": { "$value": "{font.serif}", "$type": "fontFamily" }, "size": { "$value": "clamp(1.9rem, 3.6vw, 2.6rem)", "$type": "dimension" }, "line-height": { "$value": "1.12", "$type": "number" }, "weight": { "$value": "400", "$type": "fontWeight" }, "tracking": { "$value": "-0.02em", "$type": "dimension" } },
    "landing-heading":  { "font": { "$value": "{font.serif}", "$type": "fontFamily" }, "size": { "$value": "1.6rem", "$type": "dimension" }, "line-height": { "$value": "1.3", "$type": "number" }, "weight": { "$value": "400", "$type": "fontWeight" }, "tracking": { "$value": "-0.01em", "$type": "dimension" } },
    "landing-lede":     { "font": { "$value": "{font.sans}", "$type": "fontFamily" }, "size": { "$value": "1.1rem", "$type": "dimension" }, "line-height": { "$value": "1.7", "$type": "number" }, "weight": { "$value": "400", "$type": "fontWeight" }, "tracking": { "$value": "0", "$type": "dimension" } },
    "landing-body":     { "font": { "$value": "{font.sans}", "$type": "fontFamily" }, "size": { "$value": "0.95rem", "$type": "dimension" }, "line-height": { "$value": "1.65", "$type": "number" }, "weight": { "$value": "400", "$type": "fontWeight" }, "tracking": { "$value": "0", "$type": "dimension" } },
    "landing-eyebrow":  { "font": { "$value": "{font.mono}", "$type": "fontFamily" }, "size": { "$value": "0.7rem", "$type": "dimension" }, "line-height": { "$value": "1.4", "$type": "number" }, "weight": { "$value": "500", "$type": "fontWeight" }, "tracking": { "$value": "0.24em", "$type": "dimension" }, "transform": { "$value": "uppercase", "$type": "other" } }
  }
