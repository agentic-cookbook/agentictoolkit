{
  "name": "@agentic-toolkit/ui",
  "version": "0.1.0",
  "description": "shadcn slot for agentic-web-toolkit. Ships globals.css, cn() helper, and shared hooks.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "comment:files": "`src/styles` ships ALONGSIDE dist: the `./styles/globals.css` export resolves to `./src/styles/globals.css` unconditionally (prod too), and `pnpm deploy`/`npm pack` only include listed paths. See @adh-shared/adh comment:files for the full rationale.",
  "files": [
    "dist",
    "src/styles"
  ],
  "comment:exports": "`development` → src for `next dev` (HMR, no build/restart); prod (NODE_ENV=production) skips it → dist. Self-degrading if the bundler ignores it. See @adh-shared/adh for the full rationale. Wildcards: components/* and blocks/* are all .tsx (blocks/index.ts is served by the exact ./blocks key, never the wildcard).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "development": "./src/lib/utils.ts",
      "import": "./dist/lib/utils.js"
    },
    "./lib/step-index": {
      "types": "./dist/lib/step-index.d.ts",
      "development": "./src/lib/step-index.ts",
      "import": "./dist/lib/step-index.js"
    },
    "./lib/search-params": {
      "types": "./dist/lib/search-params.d.ts",
      "development": "./src/lib/search-params.ts",
      "import": "./dist/lib/search-params.js"
    },
    "./lib/errors": {
      "types": "./dist/lib/errors.d.ts",
      "development": "./src/lib/errors.ts",
      "import": "./dist/lib/errors.js"
    },
    "./lib/typography": {
      "types": "./dist/lib/typography.d.ts",
      "development": "./src/lib/typography.ts",
      "import": "./dist/lib/typography.js"
    },
    "./lib/nav-rail": {
      "types": "./dist/lib/nav-rail.d.ts",
      "development": "./src/lib/nav-rail.ts",
      "import": "./dist/lib/nav-rail.js"
    },
    "./lib/tone": {
      "types": "./dist/lib/tone.d.ts",
      "development": "./src/lib/tone.ts",
      "import": "./dist/lib/tone.js"
    },
    "./lib/invitations-types": {
      "types": "./dist/lib/invitations-types.d.ts",
      "development": "./src/lib/invitations-types.ts",
      "import": "./dist/lib/invitations-types.js"
    },
    "./lib/invitations-endpoints": {
      "types": "./dist/lib/invitations-endpoints.d.ts",
      "development": "./src/lib/invitations-endpoints.ts",
      "import": "./dist/lib/invitations-endpoints.js"
    },
    "./lib/navigation-guard": {
      "types": "./dist/lib/navigation-guard.d.ts",
      "development": "./src/lib/navigation-guard.ts",
      "import": "./dist/lib/navigation-guard.js"
    },
    "./hooks/useIsomorphicLayoutEffect": {
      "types": "./dist/hooks/useIsomorphicLayoutEffect.d.ts",
      "development": "./src/hooks/useIsomorphicLayoutEffect.ts",
      "import": "./dist/hooks/useIsomorphicLayoutEffect.js"
    },
    "./hooks/useClipboard": {
      "types": "./dist/hooks/useClipboard.d.ts",
      "development": "./src/hooks/useClipboard.ts",
      "import": "./dist/hooks/useClipboard.js"
    },
    "./hooks/useMediaQuery": {
      "types": "./dist/hooks/useMediaQuery.d.ts",
      "development": "./src/hooks/useMediaQuery.ts",
      "import": "./dist/hooks/useMediaQuery.js"
    },
    "./hooks/useAction": {
      "types": "./dist/hooks/useAction.d.ts",
      "development": "./src/hooks/useAction.ts",
      "import": "./dist/hooks/useAction.js"
    },
    "./hooks/useDualModeSelection": {
      "types": "./dist/hooks/useDualModeSelection.d.ts",
      "development": "./src/hooks/useDualModeSelection.ts",
      "import": "./dist/hooks/useDualModeSelection.js"
    },
    "./hooks/useInlineDrafts": {
      "types": "./dist/hooks/useInlineDrafts.d.ts",
      "development": "./src/hooks/useInlineDrafts.ts",
      "import": "./dist/hooks/useInlineDrafts.js"
    },
    "./hooks/useDirtyDraft": {
      "types": "./dist/hooks/useDirtyDraft.d.ts",
      "development": "./src/hooks/useDirtyDraft.ts",
      "import": "./dist/hooks/useDirtyDraft.js"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./styles/components.css": "./src/styles/components.css",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "development": "./src/components/*.tsx",
      "import": "./dist/components/*.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "development": "./src/blocks/index.ts",
      "import": "./dist/blocks/index.js"
    },
    "./blocks/*": {
      "types": "./dist/blocks/*.d.ts",
      "development": "./src/blocks/*.tsx",
      "import": "./dist/blocks/*.js"
    },
    "./lib/slug": {
      "types": "./dist/lib/slug.d.ts",
      "development": "./src/lib/slug.ts",
      "import": "./dist/lib/slug.js"
    },
    "./lib/rdid": {
      "types": "./dist/lib/rdid.d.ts",
      "development": "./src/lib/rdid.ts",
      "import": "./dist/lib/rdid.js"
    }
  },
  "scripts": {
    "build": "tsup && pnpm run build:types && pnpm run build:css",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "build:css": "node ../../copy-css.mjs",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "harper.js": "^2.4.0",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "jsdom": "^29.0.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6",
    "vitest": "^4.1.4"
  }
}
