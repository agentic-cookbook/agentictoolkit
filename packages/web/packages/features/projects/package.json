{
  "name": "@agentic-toolkit/projects",
  "version": "0.1.0",
  "description": "The Projects feature: ProjectsFeature + its panes/views (overview, work-items surface with five views, editor, activity) over the resource substrate.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "sources.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "comment:exports": "`development` → src for `next dev` (HMR); prod skips it → dist. `./sources.css` is the Tailwind @source self-registration a host @imports once.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./sources.css": "./sources.css",
    "./parse": {
      "types": "./dist/parse-path.d.ts",
      "development": "./src/parse-path.ts",
      "import": "./dist/parse-path.js"
    },
    "./profile": {
      "types": "./dist/ProfileProjects.d.ts",
      "development": "./src/ProfileProjects.tsx",
      "import": "./dist/ProfileProjects.js"
    }
  },
  "scripts": {
    "build": "tsup && pnpm run build:types",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentic-toolkit/adh": "workspace:*",
    "@agentic-toolkit/auth": "workspace:*",
    "@agentic-toolkit/data": "workspace:*",
    "@agentic-toolkit/teams": "workspace:*",
    "@agentic-toolkit/resource": "workspace:*",
    "@agentic-toolkit/ui": "workspace:*",
    "lucide-react": "^1.16.0"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "jsdom": "^29.0.2",
    "next": "^15.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
