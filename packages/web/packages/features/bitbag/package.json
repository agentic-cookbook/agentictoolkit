{
  "name": "@agentic-toolkit/bitbag",
  "version": "0.1.0",
  "description": "bitbag — his persona, voice, avatar rig, and chat surface. Mounts on any site that links @agentic-developer-toolkit.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./css/bitbag-chat.css": "./dist/css/bitbag-chat.css"
  },
  "scripts": {
    "build": "tsup && pnpm run build:types && pnpm run build:css",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "build:css": "mkdir -p dist/css && cp src/styles/*.css dist/css/",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@agentic-developer-toolkit/avatar": "*",
    "@agentic-developer-toolkit/chat": "*",
    "@agentic-developer-toolkit/themes": "*",
    "gsap": "^3.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@agentic-developer-toolkit/avatar": "link:../../../../../../agentic-developer-toolkit/packages/web/packages/avatar",
    "@agentic-developer-toolkit/chat": "link:../../../../../../agentic-developer-toolkit/packages/web/packages/chat",
    "@agentic-developer-toolkit/themes": "link:../../../../../../agentic-developer-toolkit/packages/web/packages/themes",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "gsap": "^3.13.0",
    "jsdom": "^29.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
